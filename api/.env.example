# Environment Variables — HummingX Portal API
# Copy this file to .env and fill in your values

# Database (Railway PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/hummingx_portal"

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET="your-super-secret-key-here"
JWT_EXPIRES_IN="7d"

# App
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:5177"

# Email (Gmail SMTP / Nodemailer)
EMAIL_USER="tu-correo@gmail.com"
EMAIL_PASS="tu-app-password"
# Interruptor de avisos automáticos de fase/diseño (la invitación de primera vez se envía siempre). 1 = automáticos
EMAIL_AUTO_NOTIFICATIONS="0"
EMAIL_DRY_RUN="1"
