// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  client
  nfc_operator
}

enum ProjectStatus {
  active
  completed
  paused
  cancelled
}

enum ReferralStatus {
  registered
  contacted
  negotiating
  converted
  inactive
}

enum CreditType {
  referral_converted
  welcome_bonus
  redeemed
  adjustment
}

enum ActivityType {
  update
  milestone
  delivery
  note
}

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  passwordHash      String?
  role              Role      @default(client)
  companyName       String?
  logoUrl           String?
  phone             String?
  referralCode      String?   @unique
  legacyReferralCode String?  @unique
  level             Int       @default(1)
  active            Boolean   @default(true)
  invitationToken   String?   @unique
  invitationExpires DateTime?
  invitationAccepted Boolean  @default(false)
  activatedAt       DateTime?
  
  resetToken           String?   @unique
  resetTokenExpires    DateTime?
  lastPasswordResetReq DateTime?

  lastLoginAt          DateTime?
  loginCount           Int       @default(0)
  totalTimeSpent       Int       @default(0) // In seconds

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  projects          Project[]
  referralsMade     Referral[]         @relation("ReferralMaker")
  creditMovements   CreditMovement[]
  projectActivities ProjectActivity[]  @relation("ActivityAuthor")
  loginEvents       LoginEvent[]
  portalSessions    PortalSession[]
  pageViews         PageView[]

  @@map("users")
}

model PortalSession {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  activeSec  Int      @default(0)
  deviceType String?
  entryPath  String?

  @@index([userId, startedAt])
  @@map("portal_sessions")
}

model LoginEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  ip         String?
  userAgent  String?
  deviceType String?
  kind       String   @default("login")

  @@index([userId, createdAt])
  @@map("login_events")
}

model PageView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  path      String
  sessionId String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("page_views")
}

model Project {
  id                  String        @id @default(cuid())
  clientId            String
  name                String
  description         String?
  currentPhase        Int           @default(1)   // 1-6
  progressPercent     Int           @default(0)   // 0-100
  estimatedDelivery   DateTime?
  status              ProjectStatus @default(active)
  internalNotes       String?
  quoteLink           String?
  contractLink        String?
  designLink          String?
  previewUrl          String?
  designStatus        String        @default("pending_review") // pending_review, approved, modifications_requested
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  // Relations
  client              User          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  activities          ProjectActivity[]
  payments            Payment[]

  @@map("projects")
}

model ProjectActivity {
  id          String       @id @default(cuid())
  projectId   String
  authorId    String?
  description String
  type        ActivityType @default(update)
  createdAt   DateTime     @default(now())

  // Relations
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author      User?        @relation("ActivityAuthor", fields: [authorId], references: [id])

  @@map("project_activities")
}

model Referral {
  id               String         @id @default(cuid())
  referrerId       String
  companyName      String
  contactName      String?
  contactEmail     String?
  contactPhone     String?
  status           ReferralStatus @default(registered)
  creditsGenerated Int            @default(0)
  notes            String?
  origin           String         @default("client_portal")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  // Relations
  referrer         User           @relation("ReferralMaker", fields: [referrerId], references: [id])
  creditMovement   CreditMovement?
  prospects        Prospect[]

  @@map("referrals")
}

model CreditMovement {
  id          String     @id @default(cuid())
  clientId    String
  referralId  String?    @unique
  amount      Int        // positive = earned, negative = redeemed
  type        CreditType
  description String
  createdAt   DateTime   @default(now())

  // Relations
  client      User       @relation(fields: [clientId], references: [id])
  referral    Referral?  @relation(fields: [referralId], references: [id], onDelete: SetNull)

  @@map("credit_movements")
}

enum PaymentStatus {
  pending
  upcoming
  completed
  overdue
}

model Payment {
  id          String        @id @default(cuid())
  projectId   String
  title       String
  description String?
  amount      Float
  status      PaymentStatus @default(pending)
  dueDate     DateTime
  paidAt      DateTime?
  invoiceLink String?
  receiptLink String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("payments")
}

enum ProposalStatus {
  new
  contacted
  converted
  rejected
}

model Proposal {
  id          String         @id @default(cuid())
  clientName  String
  companyName String?
  email       String?
  phone       String?
  pdfLink     String?
  status      ProposalStatus @default(new)
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("proposals")
}

// ─── HUMMINGX CORE: PROSPECTOS & DOCUMENTOS VERSIONADOS ──────

enum ProspectStatus {
  lead          // Nuevo contacto
  contacted     // Contactado
  meeting       // Cita / Demo agendada
  proposal_sent // Propuesta enviada
  negotiating   // En negociación
  won           // Ganado / Convertido a Cliente
  lost          // No interesado / Perdido
}

enum DocumentType {
  quote       // Cotización
  proposal    // Propuesta Técnica
  roi         // Análisis de ROI
  contract    // Contrato
  specs       // Especificaciones / Requerimientos
  other       // Otro
}

model Prospect {
  id                  String             @id @default(cuid())
  companyName         String
  contactName         String?
  email               String?
  phone               String?
  industry            String?            // Giro comercial
  estimatedValue      Float?             // Monto estimado en MXN
  status              ProspectStatus     @default(lead)
  source              String?            // Origen (Visita en frío, Referido, etc.)
  referralCode        String?            // Código del socio que recomendó (ej. 58291)
  referralId          String?            // ID de la recomendación en referrals
  notes               String?
  convertedToClientId String?            // ID del User creado si se convirtió
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  // Relaciones
  referral            Referral?          @relation(fields: [referralId], references: [id], onDelete: SetNull)
  documents           ProspectDocument[]
  appointments        Appointment[]

  @@map("prospects")
}

model ProspectDocument {
  id          String       @id @default(cuid())
  prospectId  String
  title       String
  type        DocumentType @default(quote)
  version     String       @default("v1.0") // v1.0, v1.1, v2.0
  url         String       // Link de Google Drive o PDF
  notes       String?      // Notas de cambios en esta versión
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  prospect    Prospect     @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@map("prospect_documents")
}

// ─── HUMMINGX CORE: CITAS Y VISITAS PRESENCIALES ─────────────

enum AppointmentStatus {
  scheduled   // Programada
  completed   // Realizada
  rescheduled // Reprogramada
  cancelled   // Cancelada
}

enum TeamMember {
  emmanuel    // Emmanuel
  juan_pablo  // Juan Pablo
  curiel      // Curiel
  all         // Todos / Conjunto
}

model Appointment {
  id           String            @id @default(cuid())
  title        String            // Asunto / Objetivo
  companyName  String            // Empresa o lugar
  contactName  String?
  contactPhone String?
  dateTime     DateTime          // Fecha y hora
  location     String            // Dirección física
  mapsUrl      String?           // Link a Google Maps
  assignedTo   TeamMember        @default(emmanuel)
  status       AppointmentStatus @default(scheduled)
  summary      String?           // Minuta tras la visita
  prospectId   String?           // Vinculado a prospecto si aplica
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  prospect     Prospect?         @relation(fields: [prospectId], references: [id], onDelete: SetNull)

  @@map("appointments")
}

// ─── HUMMINGX CORE: TAREAS PENDIENTES DEL EQUIPO ─────────────

enum TaskPriority {
  urgent // Fuego 🔥
  high   // Alta
  medium // Media
  low    // Baja
}

enum TaskStatus {
  todo        // Por Hacer
  in_progress // En Progreso
  review      // En Revisión
  done        // Completada
}

model TeamTask {
  id          String       @id @default(cuid())
  title       String
  description String?
  assignedTo  TeamMember   @default(all)
  priority    TaskPriority @default(medium)
  status      TaskStatus   @default(todo)
  category    String?      // Ventas, Dev, Operaciones, Clientes
  dueDate     DateTime?
  checklist   Json?        // Array de sub-tareas [{ id, text, done }]
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("team_tasks")
}

// ─── HUMMINGX CORE: PROYECTOS HISTÓRICOS Y CONTROL FINANCIERO ─

model HistoricalDeal {
  id          String   @id @default(cuid())
  clientName  String   // Nombre del cliente o empresa
  projectName String   // Proyecto o servicio realizado
  amount      Float    // Monto cobrado en MXN
  closedAt    DateTime @default(now()) // Fecha de cierre/cobro
  category    String?  // BI & Dashboards, Web App, Automatización, Consultoría
  notes       String?  // Entregables o notas de valor
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("historical_deals")
}

// ─── HUMMINGX: TARJETAS NFC & CÓDIGOS QR DINÁMICOS ───────────

enum NfcCardType {
  google_reviews // Reseñas de Google Maps
  instagram      // Seguidores en Instagram
  whatsapp       // Contacto Directo WhatsApp
  menu           // Menú Digital / Catálogo
  website        // Sitio Web / Enlace Personalizado
}

model NfcCard {
  id          String      @id @default(cuid())
  code        String      @unique // Código corto (ej. "001", "002")
  clientName  String      // Nombre de la empresa o cliente (ej. "Tahara Café")
  type        NfcCardType @default(google_reviews)
  targetUrl   String      // Enlace de destino (ej. https://g.page/r/.../review)
  active      Boolean     @default(true)
  scanCount   Int         @default(0) // Total de escaneos/taps
  notes       String?     // Notas de ubicación o entrega (ej. "En caja principal")
  latitude    Float?      // Coordenada latitud GPS (ej. 19.432608)
  longitude   Float?      // Coordenada longitud GPS (ej. -99.133209)
  locationName String?    // Dirección o referencia (ej. "Av. Insurgentes Sur 123, CDMX")
  photoUrl    String?     @db.Text // Foto de evidencia del soporte instalado (base64 o URL)
  lastScanned DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("nfc_cards")
}

// ─── HUMMINGX: GASTOS OPERATIVOS & COSTOS RECURRENTES ─────────

enum ExpenseCategory {
  infrastructure // Servidores, Hosting, Dominios, BD
  software       // APIs (OpenAI, Gemini), Licencias, Herramientas
  hardware       // Tarjetas NFC, Materiales, Soportes
  marketing      // Publicidad, Pauta, Diseños
  operations     // Gastos de operación, Viáticos, Reuniones
  other          // Otros gastos
}

enum ExpenseFrequency {
  one_time  // Gasto único
  monthly   // Recurrente mensual
  annual    // Recurrente anual
}

model Expense {
  id          String           @id @default(cuid())
  title       String           // Concepto del gasto
  amount      Float            // Monto en MXN
  category    ExpenseCategory  @default(infrastructure)
  frequency   ExpenseFrequency @default(monthly)
  paidBy      String           @default("company") // "company", "emmanuel", "juan_pablo", "curiel"
  dueDate     DateTime?        // Fecha de próximo pago / corte
  date        DateTime         @default(now())     // Fecha de registro
  receiptUrl  String?          // Comprobante / Factura
  notes       String?          // Notas o detalles
  active      Boolean          @default(true)      // Para recurrentes activos
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("expenses")
}
